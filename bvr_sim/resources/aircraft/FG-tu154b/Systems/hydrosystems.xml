            </test>
          </switch>
          
          <fcs_function name="hs/hs1-p-rev">
            <description>1 divide by p-clipped</description>
            <function>
              <product>
                <quotient>
                  <value>1.0</value>
                  <property>hs/hs1-p-clipped</property>
                </quotient>
                <value>1.0</value>
