            </test>
          </switch>    
          
          
          <switch name="hs/buster-1">
            <default value="0.0" />
            <test value="hs/hs1-busters-ok"> 
              hs/buster-1-switch == 1.0
            </test>
          </switch>
          <switch name="hs/buster-2">
            <default value="0.0" />
