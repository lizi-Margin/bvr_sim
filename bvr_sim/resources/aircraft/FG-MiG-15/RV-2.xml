<?xml version='1.0' encoding='utf-8'?>
<system name="RV-2 radar altimeter">
 


 <property value="1.2">systems/instr/RV-2/tuning/H0-m</property>


 <property value="1">systems/instr/UV-2/switch/power</property>
 
 <property>systems/instr/UV-2/switch/range</property>

 <property>systems/elec/output/RV-2/DC27-V</property>
 <property>systems/elec/output/RV-2/DC27-ok</property>


 <channel name="RV-2 slow" execrate="8">

  <fcs_function name="systems/elec/output/RV-2/DC27-A">
   <function>
    <product>
     <p>systems/instr/UV-2/switch/power</p>
     <p>systems/elec/output/RV-2/DC27-V</p>
     
     <v>0.104</v>
    </product>
   </function>
  </fcs_function>

 </channel>


 <channel name="RV-2" execrate="2">

  

  <fcs_function name="systems/instr/UV-2/gauge/height-m">
   <function>
    <product>
     <p>systems/instr/UV-2/switch/power</p>
     <p>systems/elec/output/RV-2/DC27-ok</p>
     <difference>
      <product>
       <p>position/h-agl-km</p>
       <v>1000.0</v>
       <quotient>
        <v>1.0</v>
        <max>
         <cos>
          <max>
           <difference>
            <sqrt>
             <sum>
              <product>
               <p>attitude/theta-rad</p>
               <p>attitude/theta-rad</p>
              </product>
              <product>
               <p>attitude/phi-rad</p>
               <p>attitude/phi-rad</p>
              </product>
             </sum>
            </sqrt>
            
            <v>0.2617993877991494</v>
           </difference>
           <v>0.0</v>
          </max>
         </cos>
         <v>0.0000001</v>
        </max>
       </quotient>
      </product>
      <p>systems/instr/RV-2/tuning/H0-m</p>
     </difference>
     <ifthen>
      <p>systems/instr/UV-2/switch/range</p>
      <v>0.1</v>
      <v>1.0</v>
     </ifthen>
    </product>
   </function>
   <clipto>
    <min>0.0</min>
    <max>120.0</max>
   </clipto>
  </fcs_function>

 </channel>


</system>